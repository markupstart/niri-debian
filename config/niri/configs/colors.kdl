layout {
    background-color "transparent"

    focus-ring {
        active-color   "#e2c54a"
        inactive-color "#919191"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#e2c54a"
        inactive-color "#919191"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#e2c54a"
        inactive-color "#919191"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#e2c54a80"
    }
}

recent-windows {
    highlight {
        active-color   "#544600"
        urgent-color   "#ffb4ab"
    }
}
